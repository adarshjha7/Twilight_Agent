# ─────────────────────────────────────────────
#  Supabase (same project as FleetZen)
# ─────────────────────────────────────────────
# NEVER put real keys in this file — it is committed to git.
# Real values go in .env (gitignored).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ─────────────────────────────────────────────
#  WhatsApp (JavaScript service)
# ─────────────────────────────────────────────
# WA_MONITORED_CHATS=Bills Group
WA_MONITORED_CHATS=Maintenance Payments and Bills

# URL of the Python agent service (same machine = localhost)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TIMEOUT_MS=120000

# ─────────────────────────────────────────────
#  LLM providers (Python agent service)
# ─────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini — used only by the maintenance bill extractor (Feature 7), to match
# the real backend's extractBillJson() exactly. Not used by any other tool.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: tried once if the primary key hits its free-tier quota (429)
# GEMINI_API_KEY_FALLBACK=your_second_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
#  Company Website REST API (Python agent service)
# ─────────────────────────────────────────────
WEBSITE_API_BASE_URL=https://yourcompany.com/api
WEBSITE_API_KEY=your_api_key_here
WEBSITE_BILL_ENDPOINT=/bills

# ─────────────────────────────────────────────
#  Shared
# ─────────────────────────────────────────────
STORAGE_DIR=./storage
LOG_LEVEL=INFO
